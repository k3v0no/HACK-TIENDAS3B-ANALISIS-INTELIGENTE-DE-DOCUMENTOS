# Copia este archivo como .env y rellena los valores. El .env nunca se sube al repo.

# Clave que el front envía en la cabecera X-API-Key. Pon una cadena larga y aleatoria.
API_KEY=

# Orígenes del front permitidos (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Base de datos. Vacía = SQLite en back/data/expedientes.db
DATABASE_URL=

# LLM (llave de Deploy, servicio compatible con la API de OpenAI que da acceso a DeepSeek)
DEEPSEEK_API_KEY=

# Fecha contra la que se evalúan las vigencias (AAAA-MM-DD). Vacía = fecha de hoy.
FECHA_REFERENCIA=

# OCR
OCR_DEVICE=gpu
OCR_DPI=200
OCR_LANG=es
OCR_UNWARP=true

LLM_BASE_URL=https://api.deploy.com/api/v1
LLM_MODEL=deepseek-ai/deepseek-v4.1-flash-1017
