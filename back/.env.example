# Copia este archivo como .env y rellena los valores. El .env nunca se sube al repo.

# Clave que el front envía en la cabecera X-API-Key. Pon una cadena larga y aleatoria.
API_KEY=

# Orígenes del front permitidos (separados por coma).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-chat

# OCR
OCR_DEVICE=gpu
OCR_DPI=200
OCR_LANG=es
OCR_UNWARP=true
